# ---------------------------------------------------------------------------
# Web template — environment variables
#
# Copy this file to .env.local for local dev (never commit a populated env
# file — .gitignore blocks .env* except this file). Every variable below is
# validated at boot in src/lib/env.ts (Zod), which actually runs — wired
# into instrumentation.ts's register() — so a misconfigured deployment
# fails immediately with a clear message instead of surfacing as an
# obscure runtime error three requests later. If you add a new
# process.env.X reference anywhere in the app, add it here AND to that
# schema — `pnpm check:env` fails the build if the two drift apart.
#
# See docs/CI_CD_SETUP.md for exactly what needs to be configured in
# GitHub (repo secrets, environments) vs. Vercel (project env vars) — most
# of what's below is Vercel-side; GitHub Actions secrets are a distinct,
# smaller set documented there, not duplicated here.
# ---------------------------------------------------------------------------

# --- Database: Vercel + local + CI ------------------------------------------
# App runtime connection — MUST use the pooler (transaction mode, port 6543)
# so serverless functions don't exhaust Postgres connections. Required in
# every environment, including Vercel.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"

# --- Database: local + GitHub Actions ONLY — never add these to Vercel ------
# Everything in this block is read by the Prisma CLI, never by the running
# app. `prisma generate` is the ONE Prisma command that does not need them,
# and it is the only Prisma command a Vercel build runs — so a deployment
# succeeds with them missing, and they can sit unused in a Vercel project for
# months without anything failing. Setting them there puts a full-DDL
# `postgres` credential in the app's runtime environment for no function.

# Migration connection — MUST use the direct/session connection (port 5432).
# `prisma migrate deploy` holds an advisory lock across statements that a
# transaction-mode pooler (6543) cannot sustain — using the pooler here is
# the single most common cause of migrations silently hanging in CI.
# Optional in src/lib/env.ts's schema on purpose: only the Prisma CLI reads
# it (migrate dev/deploy) and the run-once SQL runner (`pnpm db:run-once`,
# which falls back to DATABASE_URL), never the running app. See
# docs/CI_CD_SETUP.md.
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Production-only. Never present in local .env.local or in Vercel — lives
# only as a GitHub Environment secret (the "production-database"
# environment) used by .github/workflows/deploy-migrations.yml. Listed
# here for discoverability only; see docs/CI_CD_SETUP.md for where it
# actually gets configured.
# A throwaway database for the workspace repository tests (pnpm test). Leave it
# unset and those tests are skipped. Never point it at the dev or production database.
# TEST_DATABASE_URL="postgresql://user:password@localhost:5432/dojo_test"

# PRODUCTION_DATABASE_URL="postgresql://user:password@prod-host:5432/postgres"

# --- Auth (Supabase) --------------------------------------------------------
# Auth ONLY — application data still goes through Prisma/DATABASE_URL, never
# a Supabase query. See docs/rules/auth.md. `template-setup` asks whether
# this project needs accounts at all; a pure landing page removes this
# entire section, the @supabase/* dependencies, and proxy.ts's session-
# refresh logic. All three vars are optional in src/lib/env.ts's schema so
# a landing-page clone still boots without them.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=""
# Supabase's new-style keys (sb_publishable_… / sb_secret_…), NOT the legacy
# anon / service_role JWTs — those are being disabled on every project.
# The secret key is server-only, bypasses auth entirely — never exposed to
# the client, never used for anything but admin auth operations (see
# src/lib/supabase/secret-key.ts).
SUPABASE_SECRET_KEY=""
# --- Frontend dev mode (development only) -------------------------------------
# Set to "true" in .env.local to open /dashboard, /sessions and /assessment without signing in:
# a labelled mock user and fixture data (src/features/dev-frontend/), nothing is
# saved. Ignored in any production build (NODE_ENV=production), so it cannot be
# switched on in a deployment. Leave it unset to run the real sign-in flow, and
# unset it before running the sign-in e2e specs.
DOJO_DEV_FRONTEND_MODE=""

# --- Logging ---------------------------------------------------------------
# Minimum severity the server logger writes to stdout (structured JSON, one
# line per event — see docs/rules/logging.md). One of: debug | info | warn |
# error | silent. Optional; defaults to `info` (or `silent` under tests).
LOG_LEVEL=""

# --- Sentry --------------------------------------------------------------
# Client + server error tracking. Falls back to a silent no-op if unset in
# development; CI build will warn (not fail) if unset since Sentry is not
# required to build, only to report — but production deploys should always
# have this set.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# Auth token for uploading source maps at build time — CI/Vercel only,
# never needed for local dev. Generate from Sentry -> Settings -> Auth Tokens.
SENTRY_AUTH_TOKEN=""

# --- PostHog (product analytics) -----------------------------------------
# Client-side capture key — safe to expose, this is the public write-only key.
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"
# Server-side key for posthog-node. Passed as `secretKey`, it turns on LOCAL
# feature-flag evaluation (flags computed in-process from polled definitions
# instead of a network call per request; remote /flags only for what can't be
# evaluated locally, e.g. some experiments). A personal (phx_) or project-secret
# (phs_) key. Optional — flag reads still work without it, just over the network.
# This one is a real secret — never prefix it with NEXT_PUBLIC_.
# See docs/rules/feature-flags.md.
POSTHOG_PERSONAL_API_KEY=""

# --- Slack alerting (optional) ----------------------------------------------
# captureError() posts here for every unexpected (non-AppError) error in
# production — no-ops entirely if unset. Create an "Incoming Webhook" in
# Slack's app settings for the target channel. See docs/rules/error-handling.md.
SLACK_ALERT_WEBHOOK_URL=""

# --- Admin seats (optional) ------------------------------------------------
# Comma-separated email domains whose users get the lowest admin seat on first
# sign-in, e.g. "acme.com,acme.dev". Leave empty to grant every seat by hand.
# See docs/rules/authorization.md.
ADMIN_EMAIL_DOMAINS=""

# --- i18n ------------------------------------------------------------------
# Default locale used when no locale segment matches. See src/i18n/routing.ts
# for the full supported-locales list.
NEXT_PUBLIC_DEFAULT_LOCALE="en"

# --- AI insights (server only, never NEXT_PUBLIC_) ---------------------------
# Powers the AI insight endpoints: assessment explanations, session analysis,
# Prompting Guru feedback and rewrites, examples and recommendation notes.
# Off unless AI_ENABLED is exactly "true" and the chosen provider's key is set;
# Dojo works fully without it, and deterministic scores never depend on it.
# Models must be registered in src/server/lib/ai-usage/models.ts.
AI_ENABLED="false"
# openrouter (default) or xai.
AI_PROVIDER="openrouter"
# Score assessments and Prompting Guru answers with the LLM (rules engine as the
# fallback when it fails): "on" (default) or "off" (rules only, deterministic).
AI_SCORING="on"

# OpenRouter: one OpenAI-compatible API in front of many models. The default
# model is free (rate-limited); Dojo never switches to a paid model on its own.
# Get a key at https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"

# xAI (Grok), only with AI_PROVIDER=xai. Needs paid credits on the xAI team.
XAI_API_KEY=""
XAI_BASE_URL="https://api.x.ai/v1"
XAI_MODEL="grok-4.7"

# --- Cron / internal webhooks ----------------------------------------------
# Shared secret checked against the `Authorization: Bearer` header on any
# route under src/app/api/cron/**. Generate with: openssl rand -hex 32
CRON_SECRET=""

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Attached as the app_version property on every analytics event (optional —
# events just omit it if unset). Wire it to your build's version/commit in CI,
# e.g. NEXT_PUBLIC_APP_VERSION="$VERCEL_GIT_COMMIT_SHA". See docs/rules/analytics.md.
NEXT_PUBLIC_APP_VERSION=""
